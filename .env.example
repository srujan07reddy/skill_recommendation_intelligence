# ==============================================================================
# Student Skill Intelligence Platform (SSIP) — Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
APP_NAME="Student Skill Intelligence Platform"
API_V1_PREFIX=/api/v1
SECRET_KEY=dev_secret_change_in_production_min_32_chars_long

# Persistent Relational Storage (PostgreSQL)
# For local dev without docker, SQLite can be used: sqlite+aiosqlite:///./ssip_dev.db
DATABASE_URL=postgresql+asyncpg://ssip_user:ssip_secret_dev@localhost:5432/ssip_db
POSTGRES_USER=ssip_user
POSTGRES_PASSWORD=ssip_secret_dev
POSTGRES_DB=ssip_db
POSTGRES_PORT=5432

# Ephemeral Session Storage (Redis)
# If Redis is unavailable, fallback to in-memory repository is supported in development
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
SESSION_DEFAULT_TTL_HOURS=24
SESSION_MAX_TTL_HOURS=168

# Security & Tokens
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Ingestion & Uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS=xlsx,csv

# CORS & Frontend URL
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

